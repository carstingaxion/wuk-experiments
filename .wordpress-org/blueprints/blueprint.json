{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.4",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "landingPage": "/wp-admin/edit.php?post_type=gatherpress_event",
  "steps": [
    {
      "step": "login"
    },
    {
      "step": "setSiteLanguage",
      "language": "de_DE"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "WUK experiments",
        "blogdescription": "wuk xp",
        "wordpress_export_to_server__owner_repo_branch": "carstingaxion/wuk-experiments/main",
        "wordpress_export_to_server__export_home": "https://wuk-experiments.test",
        "timezone_string": "Europe/Berlin",
        "date_format": "d. F Y",
        "time_format": "H:i",
        "start_of_week": "1",
        "show_on_front": "page",
        "page_on_front": "6",
        "whl_page": "toreinfahrt",
        "whl_redirect_admin": "schade-fuer-dich"
      }
    },
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "UPLOADS": "wp-content/uploads",
        "CORE_UPGRADE_SKIP_NEW_BUNDLED": true,
        "GATHERPRESS_ALPHA_VERSION": true
      }
    },
    {
      "step": "updateUserMeta",
      "meta": {
          "admin_color": "modern",
          "show_admin_bar_front": false,
          "manageedit-gatherpress_eventcolumnshidden": [
            "taxonomy-gatherpress_topic",
            "taxonomy-_gatherpress_person",
            "date"
          ]
      },
      "userId": 1
    },
    {
      "step": "wp-cli",
      "command": "wp post delete 1 2 3 --force",
      "progress": {
        "weight": 10,
        "caption": "Deleting the WordPress default content."
      }
    },
    {
      "step": "runPHP",
      "code": "<?php @unlink('/wordpress/wp-content/plugins/hello.php'); ?>"
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "create-block-theme"
      },
      "options": {
        "activate": true
      }
    },
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/GatherPress/gatherpress/releases/download/0.34.0-beta.2/gatherpress.0.34.0-beta.2.zip"
			},
      "options": {
          "activate": true
      }
		},
    {
      "step": "installPlugin",
      "pluginData": {
          "resource": "url",
          "url": "https://github.com/carstingaxion/gatherpress-productions/releases/latest/download/gatherpress-productions.zip"
      },
      "options": {
          "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
          "resource": "url",
          "url": "https://github.com/carstingaxion/gatherpress-seasons/releases/latest/download/gatherpress-seasons.zip"
      },
      "options": {
          "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
          "resource": "url",
          "url": "https://github.com/carstingaxion/gatherpress-taxonomy-colors/releases/latest/download/gatherpress-taxonomy-colors.zip"
      },
      "options": {
          "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
          "resource": "url",
          "url": "https://github.com/carstingaxion/gatherpress-relations/releases/latest/download/gatherpress-relations.zip"
      },
      "options": {
          "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
          "resource": "url",
          "url": "https://github.com/carstingaxion/gatherpress-timed-separator/releases/latest/download/gatherpress-timed-separator.zip"
      },
      "options": {
          "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
          "resource": "url",
          "url": "https://github.com/carstingaxion/duplicate-as/releases/latest/download/duplicate-as.zip"
      },
      "options": {
          "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
          "resource": "url",
          "url": "https://github.com/carstingaxion/gatherpress-export-import/releases/latest/download/gatherpress-export-import.zip"
      },
      "options": {
          "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
          "resource": "url",
          "url": "https://github.com/carstingaxion/gatherpress-cache-invalidation-hooks/releases/latest/download/gatherpress-cache-invalidation-hooks.zip"
      },
      "options": {
          "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
          "resource": "url",
          "url": "https://github.com/carstingaxion/query-groupedby-taxonomy/releases/latest/download/query-groupedby-taxonomy.zip"
      },
      "options": {
          "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/carstingaxion/gatherpress-groups",
        "ref": "HEAD"
      },
      "options": {
        "activate": true
      },
      "progress": {
        "caption": "Installing plugin from GitHub: carstingaxion/gatherpress-groups"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/carstingaxion/gatherpress-event-status",
        "ref": "HEAD"
      },
      "options": {
        "activate": true
      },
      "progress": {
        "caption": "Installing plugin from GitHub: carstingaxion/gatherpress-event-status"
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "git:directory",
        "url": "https://github.com/carstingaxion/wuk-experiments",
        "ref": "main",
        "refType": "branch",
        "path": "wp-content/themes/wuk-experiments"
      },
      "options": {
        "activate": true,
        "targetFolderName": "wuk-experiments"
      },
      "progress": {
        "caption": "Installing theme from GitHub: carstingaxion/wuk-experiments (main)"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/mu-plugins/wuk-experiments-config.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/carstingaxion/wuk-experiments/main/wp-content/mu-plugins/wuk-experiments-config.php"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/mu-plugins/wordpress-export-to-server.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/carstingaxion/wordpress-export-to-server/main/wordpress-export-to-server.php"
      }
    },
    {
        "step": "importWxr",
        "file": {
            "resource": "url",
            "url": "https://raw.githubusercontent.com/carstingaxion/wuk-experiments/refs/heads/main/wp-content/wuk-experiments-main/export.xml"
        }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "wps-hide-login"
      },
      "options": {
        "activate": true
      }
    }
  ]
}
